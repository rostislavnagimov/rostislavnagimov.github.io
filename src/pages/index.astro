---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro'
import Pill from '../components/Pill.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects')
---

<Base
  title="Rostislav Nagimov — Systems & Full-Stack Developer"
  description="Personal website and portfolio of Rostislav Nagimov — Full-Stack & Systems developer specializing in Rust, performance optimization, and open-source tools."
>
<main class="container">
  <Card>
    <div class="line">
      <Pill>Full-stack & Systems dev</Pill>
      <a href="https://github.com/rostislavnagimov" target="_blank"><img src="/gh.svg" width="25" height="25" alt="github"/></a>
      <a href="https://www.linkedin.com/in/rostislavnagimov/" target="_blank"><img src="/li.svg" width="25" height="25" alt="linkedin"/></a>
      <a href="https://t.me/rostislavnagimov" target="_blank"><img src="/tg.svg" width="25" height="25" alt="telegram"/></a>

    </div>
    <h1>Rostislav Nagimov</h1>
    <p>Full-stack developer & open-sorce enthusiast</p>
    <p>Optimization savvy.</p>
  </Card>
      
  <Card>
    <h2>Open Sourse Projects</h2>
    <div class="list">
      {projects.map((p) => (
        <ProjectCard title={p.data.title} summary={p.data.summary} repo={p.data.repo} crates={p.data.crates} />
      ))}
    </div>
  </Card>
</main>
</Base>

