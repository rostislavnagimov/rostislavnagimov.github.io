---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Base
  title={`${project.data.title} — Rostislav Nagimov`}
  description={project.data.summary}
>
  <main class="container">
    <article class="card project-detail">
      <a class="back-link" href="/projects/">← All projects</a>
      <h1>{project.data.title}</h1>
      <p class="project-summary">{project.data.summary}</p>
      <nav class="project-links" aria-label={`${project.data.title} links`}>
        <a href={project.data.repo} target="_blank" rel="noopener noreferrer">GitHub</a>
        {project.data.crates && <a href={project.data.crates} target="_blank" rel="noopener noreferrer">Crates.io</a>}
      </nav>
      <div class="project-copy"><Content /></div>
    </article>
  </main>
</Base>
